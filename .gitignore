# Python application environment and build outputs
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Frontend generated files
frontend/node_modules/
frontend/dist/
frontend/.vite/

# User engines: retain documentation, never commit upstream source trees
/engine/*
!/engine/README.md

# Runtime state and local settings
/data/
/runtime/
.env
.env.*
!.env.example
*.log
*.safetensors
*.ckpt
*.pt
*.pth

# Editor / OS generated files
.DS_Store
Thumbs.db

.vscode/
.claude/
.codex/
.commandcode/
# Bundled release runtime (generated offline, not source-controlled)
/python_runtime/
/python_runtime.previous-*/
/.python-runtime-build-*/

# Generated launcher: 13 KB, compiled from desktop/*.cs by scripts\build_launcher.ps1
# and rebuilt by build.cmd. Tracking it only dirties the tree on every build (the
# compiler embeds a timestamp) and it cannot run without python_runtime/ next to it,
# which is not in the repository either.
/LP-Lora-Trainer.exe

# Exclude the contents, not the directory: git cannot re-include a file whose
# parent directory is excluded. The two guides below are linked from the README
# and are meant for users; the machine-specific handoff notes stay ignored.
docs/development/*
!docs/development/运行与安装.md
!docs/development/启动权限与导出修复.md

# Stray build-machine artifacts, referenced by nothing.
runtime_diff.txt
/torchinductor_*/

output/
